# Copy this file to .env.development / .env.production and fill in real values.
# These map to appsettings.json sections using "__" as the nesting separator,
# and are loaded as process environment variables, which override appsettings.*.json.

ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=appdb;Username=admin;Password=admin

Jwt__SigningKey=

GoogleAuth__ClientId=
GoogleAuth__ClientSecret=

Auth__AdminEmail=
