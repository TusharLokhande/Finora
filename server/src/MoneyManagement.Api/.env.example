ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=<database-name>;Username=<username>;Password=<password>
Jwt__SigningKey=<change-me>
GoogleAuth__ClientId=<change-me>
GoogleAuth__ClientSecret=<change-me>
Cors__AllowedOrigins__0=<client-url>
GoogleAuth__RedirectUri=<api-url>/api/auth/google/callback
Auth__FrontendBaseUrl=<client-url>
Auth__AllowedEmails__0=<replace-with-your-email>
Auth__AdminEmail=<replace-with-your-email>

# OpenTelemetry (leave endpoint empty to disable export)
OTEL_SERVICE_NAME=finora-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://observability-otel:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
